# Copy this file to .env and fill in values.
# NEVER commit .env — it contains secrets.

### GIT ###
# GitHub personal access token used for git operations inside the container (replaces ~/.ssh host mount)
# Required permission: `repo` (classic PAT) or equivalent fine-grained repository permissions.
GIT_REMOTE_USERNAME=
GIT_REMOTE_PAT=

# Git identity inside the container (replaces ~/.gitconfig host mount)
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# opam Package Manager
OPAMSOLVERTIMEOUT=180
OPAMWORKINGDIR=true
COREPACK_ENABLE_DOWNLOAD_PROMPT=0

# `make dev`: poll for source changes instead of using dune's watch mode. Detected
# automatically on 9p mounts, set it if rebuilds don't trigger (e.g. a repository under /mnt/c)
# DEV_POLL=1

### PROJECT SPECIFIC ###
SIHL_ENV=development
VERSION=dev
PUBLIC_URL=http://localhost:3016

# Database
DATABASE_URL=mariadb://root@database-root:3306/development
DATABASE_URL_TENANT_ONE=mariadb://root@database-tenant:3306/dev_econ
DATABASE_SKIP_DEFAULT_POOL_CREATION=true
DATABASE_CHOOSE_POOL=root

# Email
SMTP_SENDER=test@econ.uzh.ch

# Matcher
MATCHER_RUN=false
